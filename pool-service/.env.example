# Copy to .env and fill in. .env is git-ignored.

# argon2 hash of your password. Generate with:  npm run hash-password
# Wrap in single quotes: the hash contains $ characters.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME'

# Signs the session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32

# Local development (docker compose up -d mongo). docker-compose.yml overrides this for the api container.
MONGO_URL=mongodb://localhost:27017/pool?replicaSet=rs0&directConnection=true

# Where photos are stored (the api container uses /data/photos).
PHOTO_DIR=./data/photos

# Secure cookies need HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

PORT=3000
LOG_LEVEL=info

# Phase 6: Cloudflare Tunnel token for the cloudflared service.
# CLOUDFLARE_TUNNEL_TOKEN=
